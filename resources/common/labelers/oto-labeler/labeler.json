{
    "name": "oto-plus.default",
    "version": 31,
    "serialVersion": 2,
    "singleFile": false,
    "extension": "ini",
    "defaultInputFilePath": "oto.ini",
    "displayedName": {
        "en": "UTAU oto labeler",
        "zh": "UTAU oto 标注器",
        "ja": "UTAU oto ラベラー",
        "ko": "UTAU oto 라벨러"
    },
    "author": "sdercolin",
    "email": "sder.colin@gmail.com",
    "description": {
        "en": "Default labeler for UTAU oto.",
        "zh": "用于 UTAU oto 的默认标注器。",
        "ja": "UTAU oto のデフォルトラベラー。",
        "ko": "기본 내장된 UTAU oto용 라벨러에요."
    },
    "website": "https://github.com/sdercolin/vlabeler/tree/main/resources/common/labelers",
    "categoryTag": "UTAU",
    "displayOrder": 1,
    "defaultValues": [
        100,
        400,
        300,
        200,
        100,
        500
    ],
    "fields": [
        {
            "name": "fixed",
            "label": {
                "en": "Fixed",
                "zh": "固",
                "ja": "子",
                "ko": "고정"
            },
            "color": "#1b51ff",
            "height": 0.5,
            "dragBase": false,
            "filling": "left",
            "constraints": [
                {
                    "min": 3,
                    "max": null,
                    "useEndAsMax": true,
                    "pushMax": true,
                    "pushedByMax": true,
                    "sticky": false
                }
            ],
            "shortcutIndex": 3,
            "triggerPostEditDone": true
        },
        {
            "name": "preu",
            "label": {
                "en": "Preu",
                "zh": "先",
                "ja": "先",
                "ko": "선행"
            },
            "color": "#ff1a45",
            "height": 0.6667,
            "dragBase": true,
            "filling": null,
            "constraints": [
                {
                    "min": 3,
                    "max": 0
                }
            ],
            "shortcutIndex": 2,
            "triggerPostEditDone": true
        },
        {
            "name": "ovl",
            "label": {
                "en": "Ovl",
                "zh": "重",
                "ja": "オ",
                "ko": "오버"
            },
            "color": "#7fff39",
            "height": 0.8333,
            "dragBase": false,
            "filling": null,
            "constraints": [
                {
                    "min": null,
                    "max": 0,
                    "pushedByMin": true,
                    "sticky": false
                }
            ],
            "shortcutIndex": 1,
            "triggerPostEditDone": true
        },
        {
            "name": "left",
            "label": {
                "en": "Left",
                "zh": "左",
                "ja": "左",
                "ko": "왼쪽"
            },
            "color": "#9c7212",
            "height": 0.9,
            "dragBase": false,
            "filling": "start",
            "constraints": [],
            "replaceStart": true
        }
    ],
    "extraFields": [
        {
            "name": "rawRight",
            "displayedName": "Raw right",
            "default": "500"
        }
    ],
    "extraFieldNames": [
        "rawRight"
    ],
    "lockedDrag": {
        "useDragBase": true,
        "useStart": false
    },
    "overflowBeforeStart": "AdjustBorder",
    "overflowAfterEnd": "AdjustBorder",
    "postEditDoneTrigger": {
        "useStart": true,
        "useEnd": true
    },
    "entrySimilarityWeights": {
        "name": 6,
        "sample": 12,
        "start": 1,
        "end": 1,
        "points": [
            1,
            1,
            1,
            1
        ],
        "extras": [
            0
        ],
        "tag": 0,
        "threshold": 0.75
    },
    "properties": [
        {
            "name": "left",
            "displayedName": {
                "en": "Offset",
                "zh": "左边界",
                "ja": "左ブランク",
                "ko": "오프셋"
            },
            "valueGetter": "left-getter.js",
            "valueSetter": "left-setter.js",
            "shortcutIndex": 0
        },
        {
            "name": "ovl",
            "displayedName": {
                "en": "Overlap",
                "zh": "重叠",
                "ja": "オーバーラップ",
                "ko": "오버랩"
            },
            "valueGetter": "ovl-getter.js",
            "valueSetter": "ovl-setter.js",
            "shortcutIndex": 1
        },
        {
            "name": "preu",
            "displayedName": {
                "en": "Preutterance",
                "zh": "先行发声",
                "ja": "先行発声",
                "ko": "선행자음부"
            },
            "valueGetter": "preu-getter.js",
            "valueSetter": "preu-setter.js",
            "shortcutIndex": 2
        },
        {
            "name": "fixed",
            "displayedName": {
                "en": "Fixed",
                "zh": "固定",
                "ja": "固定範囲",
                "ko": "고정자음부"
            },
            "valueGetter": "fixed-getter.js",
            "valueSetter": "fixed-setter.js",
            "shortcutIndex": 3
        },
        {
            "name": "right",
            "displayedName": {
                "en": "Cutoff",
                "zh": "右边界",
                "ja": "右ブランク",
                "ko": "컷오프"
            },
            "valueGetter": "right-getter.js",
            "valueSetter": "right-setter.js",
            "shortcutIndex": 4
        }
    ],
    "parser": {
        "scope": "Entry",
        "defaultEncoding": "Shift-JIS",
        "extractionPattern": "(.*)=(.*),(.*),(.*),(.*),(.*),(.*)",
        "variableNames": [
            "sample",
            "name",
            "left",
            "fixed",
            "right",
            "preu",
            "ovl"
        ],
        "scripts": "parser.js"
    },
    "writer": {
        "scope": "Entry",
        "format": "{sample}={name},{left},{fixed},{right},{preu},{ovl}"
    },
    "parameters": [
        {
            "parameter": {
                "type": "boolean",
                "name": "useNegativeOvl",
                "label": {
                    "en": "Allow negative overlap",
                    "zh": "允许重叠为负值",
                    "ja": "オーバーラップのマイナス値を許容する",
                    "ko": "오버랩 음수값 허용하기"
                },
                "defaultValue": true
            },
            "injector": "useNegativeOvl-injector.js",
            "changeable": true
        },
        {
            "parameter": {
                "type": "boolean",
                "name": "keepPushedOverlap",
                "label": {
                    "en": "Keep pushed overlap when dragging offset back",
                    "zh": "左边界挤压重叠时保持挤压结果",
                    "ja": "左ブランクでオーバーラップを押し出した位置を維持する",
                    "ko": "오프셋으로 밀어낸 오버랩 위치 유지하기"
                },
                "description": {
                    "en": "When negative overlap is disallowed, dragging offset past overlap pushes overlap along. If enabled, overlap stays at the pushed position when dragging offset back.",
                    "zh": "禁用“允许重叠为负值”时，向右拖动左边界越过重叠会带动重叠一起移动。启用此项后，在同一次拖动中将左边界往回拖时，重叠将保持在被推到的位置而不恢复原值。",
                    "ja": "「オーバーラップのマイナス値を許容する」が無効な場合、左ブランクをオーバーラップより右へドラッグするとオーバーラップも一緒に移動します。これを有効にすると、ドラッグ中に左ブランクを戻してもオーバーラップは押し出された位置に留まります。",
                    "ko": "오버랩 음수값 허용이 꺼져 있을 때 오프셋을 오버랩 너머로 드래그하면 오버랩이 함께 밀려납니다. 이 옵션을 켜면 드래그 도중 오프셋을 되돌려도 오버랩이 밀려난 위치에 그대로 유지됩니다."
                },
                "defaultValue": false
            },
            "injector": "keepPushedOverlap-injector.js",
            "changeable": true
        },
        {
            "parameter": {
                "type": "boolean",
                "name": "keepPushedFixedAndRight",
                "label": {
                    "en": "Keep pushed position between fixed and cutoff",
                    "zh": "右边界与固定范围互相挤压时保持挤压结果",
                    "ja": "右ブランクと固定範囲の押し出し位置を維持する",
                    "ko": "컷오프와 고정자음부가 서로 밀어낸 위치 유지하기"
                },
                "description": {
                    "en": "Dragging cutoff past fixed or dragging fixed past cutoff pushes the other along. If enabled, the pushed parameter stays at the pushed position when dragging back.",
                    "zh": "拖动右边界越过固定范围，或拖动固定范围越过右边界时，会带动对方一起移动。启用此项后，在同一次拖动中往回拖时，被推动的参数将保持在被推到的位置而不恢复原值。",
                    "ja": "右ブランクと固定範囲を互いを超えてドラッグすると、もう一方も一緒に移動します。これを有効にすると、ドラッグ中に戻しても押し出されたパラメータはその位置に留まります。",
                    "ko": "컷오프와 고정자음부를 서로의 위치 너머로 드래그하면 다른 쪽이 함께 밀려납니다. 이 옵션을 켜면 드래그 도중 되돌려도 밀려난 파라미터가 그 위치에 그대로 유지됩니다."
                },
                "defaultValue": false
            },
            "injector": "keepPushedFixedAndRight-injector.js",
            "changeable": true
        },
        {
            "parameter": {
                "type": "enum",
                "name": "dragBase",
                "label": {
                    "en": "Base for fixed-drag",
                    "zh": "锁定拖动的基准参数",
                    "ja": "連動ドラッグの基準",
                    "ko": "고정 드래그의 기준 마커"
                },
                "defaultValue": "Preutterance",
                "options": [
                    "Left",
                    "Overlap",
                    "Preutterance",
                    "Fixed"
                ],
                "optionDisplayedNames": [
                    {
                        "en": "Left",
                        "zh": "左边界",
                        "ja": "左ブランク",
                        "ko": "왼쪽 끝"
                    },
                    {
                        "en": "Overlap",
                        "zh": "重叠",
                        "ja": "オーバーラップ",
                        "ko": "오버랩"
                    },
                    {
                        "en": "Preutterance",
                        "zh": "先行发声",
                        "ja": "先行発声",
                        "ko": "선행자음부"
                    },
                    {
                        "en": "Fixed",
                        "zh": "固定",
                        "ja": "固定範囲",
                        "ko": "고정자음부"
                    }
                ]
            },
            "injector": "dragBase-injector.js",
            "changeable": true
        },
        {
            "parameter": {
                "type": "enum",
                "name": "postEditNextTrigger",
                "label": {
                    "en": "Go to next entry after editing",
                    "zh": "编辑后跳转到下一个条目",
                    "ja": "編集後に次のエントリーに移動する",
                    "ko": "편집이 끝나면 다음 엔트리로 이동"
                },
                "description": {
                    "en": "Please enable this action in `Preferences` -> `Editor` -> `Post-editing actions`, and choose `Use settings defined by the labeler` as the trigger.",
                    "zh": "请在`环境设置`->`编辑器`->`编辑后动作`中启用此功能，并选择`使用标注器的设置`为`触发该行为的参数`。",
                    "ja": "`環境設定`->`エディタ`->`編集後アクション`でこの機能を有効にし、`アクションを実行できるパラメータ`では`ラベラーの設定`を選択してください。",
                    "ko": "활성화하려면 `환경설정` -> `에디터` -> `사전편집 동작`을 누른 후, `라벨러에 의해 정의된 설정 사용`을 선택해 주세요."
                },
                "defaultValue": "Disable",
                "options": [
                    "Disable",
                    "Left",
                    "Overlap",
                    "Preutterance",
                    "Fixed",
                    "Cutoff",
                    "Any"
                ],
                "optionDisplayedNames": [
                    {
                        "en": "Disable",
                        "zh": "禁用",
                        "ja": "無効",
                        "ko": "비활성"
                    },
                    {
                        "en": "Left",
                        "zh": "左边界",
                        "ja": "左ブランク",
                        "ko": "왼쪽 끝"
                    },
                    {
                        "en": "Overlap",
                        "zh": "重叠",
                        "ja": "オーバーラップ",
                        "ko": "오버랩"
                    },
                    {
                        "en": "Preutterance",
                        "zh": "先行发声",
                        "ja": "先行発声",
                        "ko": "선행자음부"
                    },
                    {
                        "en": "Fixed",
                        "zh": "固定",
                        "ja": "固定範囲",
                        "ko": "고정자음부"
                    },
                    {
                        "en": "Cutoff",
                        "zh": "右边界",
                        "ja": "右ブランク",
                        "ko": "컷오프"
                    },
                    {
                        "en": "Any",
                        "zh": "任意",
                        "ja": "任意",
                        "ko": "아무거나"
                    }
                ]
            },
            "injector": "postEditNextTrigger-injector.js",
            "changeable": true
        },
        {
            "parameter": {
                "type": "enum",
                "name": "postEditDoneTrigger",
                "label": {
                    "en": "Mark entry as `Done` after editing",
                    "zh": "编辑后标记为已完成条目",
                    "ja": "編集後にエントリーを\"完了\"にする",
                    "ko": "편집된 엔트리에 자동으로 \"완료\" 표시"
                },
                "description": {
                    "en": "Please enable this action in `Preferences` -> `Editor` -> `Post-editing actions`, and choose `Use settings defined by the labeler` as the trigger.",
                    "zh": "请在`环境设置`->`编辑器`->`编辑后动作`中启用此功能，并选择`使用标注器的设置`为`触发该行为的参数`。",
                    "ja": "`環境設定`->`エディタ`->`編集後アクション`でこの機能を有効にし、`アクションを実行できるパラメータ`では`ラベラーの設定`を選択してください。",
                    "ko": "활성화하려면 `환경설정` -> `에디터` -> `사전편집 동작`을 누른 후, `라벨러에 의해 정의된 설정 사용`을 선택해 주세요."
                },
                "defaultValue": "Any",
                "options": [
                    "Disable",
                    "Left",
                    "Overlap",
                    "Preutterance",
                    "Fixed",
                    "Cutoff",
                    "Any"
                ],
                "optionDisplayedNames": [
                    {
                        "en": "Disable",
                        "zh": "禁用",
                        "ja": "無効",
                        "ko": "비활성"
                    },
                    {
                        "en": "Left",
                        "zh": "左边界",
                        "ja": "左ブランク",
                        "ko": "왼쪽 끝"
                    },
                    {
                        "en": "Overlap",
                        "zh": "重叠",
                        "ja": "オーバーラップ",
                        "ko": "오버랩"
                    },
                    {
                        "en": "Preutterance",
                        "zh": "先行发声",
                        "ja": "先行発声",
                        "ko": "선행자음부"
                    },
                    {
                        "en": "Fixed",
                        "zh": "固定",
                        "ja": "固定範囲",
                        "ko": "고정자음부"
                    },
                    {
                        "en": "Cutoff",
                        "zh": "右边界",
                        "ja": "右ブランク",
                        "ko": "컷오프"
                    },
                    {
                        "en": "Any",
                        "zh": "任意",
                        "ja": "任意",
                        "ko": "아무거나"
                    }
                ]
            },
            "injector": "postEditDoneTrigger-injector.js",
            "changeable": true
        }
    ],
    "quickProjectBuilders": [
        {
            "name": "default",
            "displayedName": {
                "en": "Edit UTAU oto file",
                "zh": "编辑 UTAU oto 文件",
                "ja": "UTAU oto を編集する",
                "ko": "UTAU oto 파일 편집"
            },
            "description": {
                "en": "Select your UTAU oto file to start quick editing.",
                "zh": "选择您的 UTAU oto 文件以开始快捷编辑。",
                "ja": "UTAU oto ファイルを選択して、クイック編集を開始します。",
                "ko": "UTAU oto 파일을 선택하여 빠른 편집을 시작합니다."
            },
            "extension": "ini",
            "scripts": "quickProjectBuilder.js"
        }
    ]
}
